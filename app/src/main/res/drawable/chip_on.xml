<?xml version="1.0" encoding="utf-8"?>
<!-- Hard 0dp offset shadow + 3dp charcoal border, square corners. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="@color/primary"/><stroke android:width="3dp" android:color="@color/border"/></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/primary"/><stroke android:width="3dp" android:color="@color/border"/></shape></item>
</selector>
