<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View android:id="@+id/sr_rule" android:layout_width="match_parent" android:layout_height="3dp"
        android:background="@color/border" />

    <LinearLayout
        android:id="@+id/sr_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView android:id="@+id/sr_kind" style="@style/Kicker"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/sr_name"
            style="@style/Serif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/sr_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:visibility="gone" />
        <FrameLayout
            android:id="@+id/sr_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</LinearLayout>
