<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- top app bar: back to stations | station name | settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bar_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="17dp">

        <ImageButton
            android:id="@+id/stations_button"
            style="@style/IconButton"
            android:contentDescription="@string/stations"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:id="@+id/header_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView style="@style/Kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/on_the_dial" />
            <TextView
                android:id="@+id/header"
                style="@style/SerifItalic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textSize="20sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settings_button"
            style="@style/IconButton"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp">

            <!-- artwork: hero card, 8dp hard shadow -->
            <FrameLayout
                android:id="@+id/art_card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/box_8"
                android:paddingStart="3dp"
                android:paddingTop="3dp"
                android:paddingEnd="11dp"
                android:paddingBottom="11dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="420dp">

                <ImageView
                    android:id="@+id/artwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/album_art"
                    android:scaleType="centerCrop"
                    android:src="@drawable/station_art" />

                <TextView
                    android:id="@+id/status"
                    style="@style/Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:background="@drawable/chip_on"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp"
                    android:textColor="@color/on_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/np_label"
                style="@style/Kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/now_playing"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/art_card" />

            <TextView
                android:id="@+id/title"
                style="@style/Serif"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="3"
                android:text="@string/app_name"
                android:textSize="32sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/np_label" />

            <TextView
                android:id="@+id/artist"
                style="@style/Kicker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tagline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title" />

            <!-- transport: previous | big orange play | next -->
            <LinearLayout
                android:id="@+id/transport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/artist">

                <ImageButton
                    android:id="@+id/prev_button"
                    style="@style/IconButton"
                    android:layout_width="68dp"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/previous_song"
                    android:paddingStart="18dp"
                    android:paddingEnd="22dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_skip_previous" />

                <LinearLayout
                    android:id="@+id/play_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/box_primary_8"
                    android:clickable="true"
                    android:contentDescription="@string/play"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="104dp"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="22dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:id="@+id/play_kicker" style="@style/Kicker"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/tune_in" android:textColor="@color/on_primary" />
                        <TextView
                            android:id="@+id/play_label"
                            style="@style/SerifItalic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/listen_live"
                            android:textColor="@color/on_primary"
                            android:textSize="28sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/play_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/field"
                        android:importantForAccessibility="no"
                        android:padding="12dp"
                        android:src="@drawable/ic_play"
                        app:tint="@color/ink" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/next_button"
                    style="@style/IconButton"
                    android:layout_width="68dp"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/next_song"
                    android:paddingStart="18dp"
                    android:paddingEnd="22dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_skip_next" />
            </LinearLayout>

            <TextView
                android:id="@+id/rate_label"
                style="@style/Kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/your_rating"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/transport" />

            <!-- stars: one segmented row, filled cells turn orange -->
            <LinearLayout
                android:id="@+id/stars_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/box_4"
                android:divider="@drawable/divider_v"
                android:orientation="horizontal"
                android:paddingStart="3dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="7dp"
                android:showDividers="middle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rate_label">

                <ImageButton android:id="@+id/star1" android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:background="@color/card" android:contentDescription="@string/star_1"
                    android:padding="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_star" app:tint="@color/muted" />
                <ImageButton android:id="@+id/star2" android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:background="@color/card" android:contentDescription="@string/star_2"
                    android:padding="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_star" app:tint="@color/muted" />
                <ImageButton android:id="@+id/star3" android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:background="@color/card" android:contentDescription="@string/star_3"
                    android:padding="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_star" app:tint="@color/muted" />
                <ImageButton android:id="@+id/star4" android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:background="@color/card" android:contentDescription="@string/star_4"
                    android:padding="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_star" app:tint="@color/muted" />
                <ImageButton android:id="@+id/star5" android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:background="@color/card" android:contentDescription="@string/star_5"
                    android:padding="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_star" app:tint="@color/muted" />
            </LinearLayout>

            <!-- the running order: previously / up next -->
            <LinearLayout
                android:id="@+id/queue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:background="@drawable/box_4"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="7dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/stars_row">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/border"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp">
                    <TextView style="@style/Kicker" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/running_order" android:textColor="@color/card" />
                    <TextView style="@style/SerifItalic" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/before_after" android:textColor="@color/card" android:textSize="14sp" />
                </LinearLayout>

                <include android:id="@+id/prev_row" layout="@layout/row_track" />
                <include android:id="@+id/next_row" layout="@layout/row_track" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
