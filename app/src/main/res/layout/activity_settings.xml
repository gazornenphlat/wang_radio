<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bar_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="17dp">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView style="@style/Kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/station_desk" />
            <TextView style="@style/SerifItalic" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/app_name" android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView style="@style/Kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/radio_toml" />
            <TextView
                style="@style/Serif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="-0.02"
                android:text="@string/the_settings"
                android:textSize="44sp" />

            <!-- I. This phone: where the station is -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/box_4"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="7dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/border"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp">
                    <TextView style="@style/Kicker" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/this_phone" android:textColor="@color/card" />
                    <TextView style="@style/SerifItalic" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/connection" android:textColor="@color/card" android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView style="@style/Kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/server_url" />
                    <EditText
                        android:id="@+id/server_url"
                        style="@style/Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/server_url_hint"
                        android:importantForAutofill="no"
                        android:inputType="textUri" />

                    <TextView style="@style/Kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" android:text="@string/server_key" />
                    <EditText
                        android:id="@+id/server_key"
                        style="@style/Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAutofill="no"
                        android:inputType="textPassword" />

                    <TextView style="@style/Kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" android:text="@string/appearance" />
                    <LinearLayout
                        android:id="@+id/theme_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/field"
                        android:divider="@drawable/divider_v"
                        android:orientation="horizontal"
                        android:padding="3dp"
                        android:showDividers="middle">
                        <TextView android:id="@+id/theme_system" style="@style/Kicker" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
                            android:paddingVertical="14dp" android:text="@string/theme_system" />
                        <TextView android:id="@+id/theme_light" style="@style/Kicker" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
                            android:paddingVertical="14dp" android:text="@string/theme_light" />
                        <TextView android:id="@+id/theme_dark" style="@style/Kicker" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
                            android:paddingVertical="14dp" android:text="@string/theme_dark" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/settings_help"
                        android:textColor="@color/muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/save_connection"
                        style="@style/Kicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/box_4"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="18dp"
                        android:text="@string/save_connection" />
                </LinearLayout>
            </LinearLayout>

            <!-- locked / offline / admin password -->
            <LinearLayout
                android:id="@+id/gate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:background="@drawable/box_4"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp"
                android:visibility="gone">
                <TextView android:id="@+id/gate_kicker" style="@style/Kicker"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/gate_title"
                    style="@style/Serif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="24sp" />
                <TextView
                    android:id="@+id/gate_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="14sp" />
                <LinearLayout
                    android:id="@+id/admin_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <EditText
                        android:id="@+id/admin_password"
                        style="@style/Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/admin_hint"
                        android:importantForAutofill="no"
                        android:inputType="textPassword" />
                    <TextView
                        android:id="@+id/unlock"
                        style="@style/Kicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/box_4"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="18dp"
                        android:text="@string/unlock" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <EditText
                    android:id="@+id/find"
                    style="@style/Field"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/find_setting"
                    android:importantForAutofill="no"
                    android:inputType="text" />
                <TextView
                    android:id="@+id/count"
                    style="@style/Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/restart_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/restart_note"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- sticky save bar -->
    <LinearLayout
        android:id="@+id/save_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bar_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="15dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/save_msg"
            style="@style/Kicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/no_changes" />
        <TextView
            android:id="@+id/save_button"
            style="@style/SerifItalic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/box_primary_8"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="28dp"
            android:paddingBottom="20dp"
            android:text="@string/save_changes"
            android:textColor="@color/on_primary"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>
