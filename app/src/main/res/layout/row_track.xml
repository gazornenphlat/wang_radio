<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View android:layout_width="match_parent" android:layout_height="3dp" android:background="@color/border" />

    <LinearLayout
        android:id="@+id/row_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/field"
            android:padding="3dp">
            <ImageView
                android:id="@+id/row_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/station_art" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/row_label" style="@style/Kicker"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/row_title"
                style="@style/Serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/row_artist"
                style="@style/Kicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- only shown on the "up next" row: swap the song before it plays -->
        <TextView
            android:id="@+id/row_action"
            style="@style/Kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/box_4"
            android:clickable="true"
            android:contentDescription="@string/skip_upnext_desc"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp"
            android:text="@string/skip_upnext"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
